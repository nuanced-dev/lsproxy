{
  "name": "@nuanced-dev/lsp",
  "version": "0.5.1",
  "description": "TypeScript library and CLI for Nuanced LSP",
  "license": "MIT",
  "author": "Nuanced",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuanced-dev/lsp.git"
  },
  "type": "module",
  "bin": {
    "nuanced-lsp": "dist/cli.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build:cli && npm run build:lib && npm run build:cjs",
    "build:cjs": "scripts/build-cjs.mjs",
    "build:cli": "scripts/build-esbuild.mjs",
    "build:lib": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist nuanced-dev-*.tgz",
    "dev": "tsx src/cli.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postbuild": "chmod +x dist/cli.cjs",
    "prebuild": "scripts/generate-version.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@types/node": "^20.19.25",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
