{
  "name": "@nuanced-dev/lsp",
  "type": "module",
  "bin": {
    "nuanced-lsp": "dist/cli.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build:cli && npm run build:lib && npm run build:cjs",
    "build:cjs": "scripts/build-cjs.mjs",
    "build:cli": "scripts/build-esbuild.mjs",
    "build:lib": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist obfuscated nuanced-dev-*.tgz",
    "dev": "tsx src/cli.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "obfuscate": "javascript-obfuscator dist --output dist --config obfuscator-config.json",
    "postbuild": "cp src/languages.json dist/languages.json && chmod +x dist/cli.cjs",
    "prebuild": "cp config/languages.json src/languages.json && scripts/generate-version.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run obfuscate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fastest-levenshtein": "^1.0.16",
    "micromatch": "^4.0.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^20.19.25",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.4.1",
    "javascript-obfuscator": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "version": "0.4.0",
  "publishConfig": {
    "access": "public"
  }
}
