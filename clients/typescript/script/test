#!/usr/bin/env bash
set -euo pipefail

# Test runner for the Vitest test suite.
# Requirements:
#   - Node.js 18+
#
# Options:
#   --workers N              Number of parallel workers (default: use all CPU cores)
#   --fail-fast              Stop on first failure
#   --record-fixtures        Record fixtures
#   --proxy-image <name:tag>       Docker image override (sets PROXY_IMAGE)
#   --watchdog-image <name:tag>    Docker image override for watchdog (sets WATCHDOG_IMAGE)
#   --wrapper-image <name:tag>     Docker image override for wrapper (sets WRAPPER_IMAGE)
#   --symbol-delay <secs>    Delay before symbol scenario tests (sets SYMBOL_SCENARIO_DELAY; default: 0)
#   --workspace-delay <secs> Delay before workspace scenario tests (sets WORKSPACE_SCENARIO_DELAY; default: 0)
#   --timeout <secs>         Per-command timeout (sets NUANCED_LSP_TIMEOUT; default: 120)
#
# Any additional args are passed through to Vitest.
#
# Examples:
#   script/test
#   script/test --workers 8
#   script/test --fail-fast
#   script/test --record-fixtures
#   script/test --proxy-image ghcr.io/nuanced-dev/nuanced-lsp-proxy:latest
#   script/test --timeout 300
#   script/test tests/specs/workspace-symbols.spec.ts
#   script/test --testNamePattern "find definitions"

WORKERS=                     # if empty, vitest uses all CPU cores.
FAIL_FAST=                   # if true, stop on first failure.
RECORD_FIXTURES=             # if true, record fixtures instead of comparing.
PROXY_IMAGE=                 # allows overriding the default nuanced-lsp-proxy image used in tests.
WATCHDOG_IMAGE=              # allows overriding the default nuanced-lsp-watchdog image used in tests.
WRAPPER_IMAGE=               # allows overriding the default nuanced-lsp-wrapper image used in tests.
SYMBOL_SCENARIO_DELAY=       # delay (in seconds) before running symbol scenario tests.
WORKSPACE_SCENARIO_DELAY=    # delay (in seconds) before running workspace scenario
NUANCED_LSP_TIMEOUT=         # number of seconds each test case is allowed to run.
VITEST_PASSTHRU=()           # additional args to pass to vitest (e.g. specific test files or --testNamePattern).

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workers)
      if [[ $# -gt 1 && "$2" != -* ]]; then
        export WORKERS="$2"
        shift 2
      else
        echo "Error: --workers requires a numeric value" >&2
        exit 2
      fi
      ;;
    --fail-fast)
      export FAIL_FAST=1
      shift
      ;;
    --record-fixtures)
      export RECORD_FIXTURES=1
      shift
      ;;
    --proxy-image)
      if [[ $# -gt 1 && "$2" != -* ]]; then
        export PROXY_IMAGE="$2"
        shift 2
      else
        echo "Error: --proxy-image requires a value like 'repo/name:tag'" >&2
        exit 2
      fi
      ;;
    --watchdog-image)
      if [[ $# -gt 1 && "$2" != -* ]]; then
        export WATCHDOG_IMAGE="$2"
        shift 2
      else
        echo "Error: --watchdog-image requires a value like 'repo/name:tag'" >&2
        exit 2
      fi
      ;;
    --wrapper-image)
      if [[ $# -gt 1 && "$2" != -* ]]; then
        export WRAPPER_IMAGE="$2"
        shift 2
      else
        echo "Error: --wrapper-image requires a value like 'repo/name:tag'" >&2
        exit 2
      fi
      ;;
    --symbol-delay)
      if [[ $# -gt 1 && "$2" != -* ]]; then
        export SYMBOL_SCENARIO_DELAY="$2"
        shift 2
      else
        echo "Error: --symbol-delay requires a numeric value (seconds)" >&2
        exit 2
      fi
      ;;
    --workspace-delay)
      if [[ $# -gt 1 && "$2" != -* ]]; then
        export WORKSPACE_SCENARIO_DELAY="$2"
        shift 2
      else
        echo "Error: --workspace-delay requires a numeric value (seconds)" >&2
        exit 2
      fi
      ;;
    --timeout)
      if [[ $# -gt 1 && "$2" != -* ]]; then
        export NUANCED_LSP_TIMEOUT="$2"
        shift 2
      else
        echo "Error: --timeout requires a numeric value (seconds)" >&2
        exit 2
      fi
      ;;
    *)
      VITEST_PASSTHRU+=("$1")
      shift
      ;;
  esac
done

npm run build

CMD=(npx vitest run)
[[ ${#VITEST_PASSTHRU[@]} -gt 0 ]] && CMD+=("${VITEST_PASSTHRU[@]}")

exec "${CMD[@]}"
