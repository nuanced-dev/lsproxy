      "source_code": "static class FizzBuzz {\n    public static string Of(int n) =>\n        (n % 15 == 0) ? \"fizzbuzz\" :\n        (n % 3 == 0)  ? \"fizz\" :\n        (n % 5 == 0)  ? \"buzz\" : n.ToString();\n}"
