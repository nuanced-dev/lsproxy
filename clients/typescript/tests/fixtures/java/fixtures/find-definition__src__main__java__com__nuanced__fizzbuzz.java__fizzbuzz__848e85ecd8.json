      "source_code": "public static String fizzBuzz(int n) {\n    if (n % 15 == 0) return \"fizzbuzz\";\n    if (n % 3 == 0) return \"fizz\";\n    if (n % 5 == 0) return \"buzz\";\n    return Integer.toString(n);\n  }"
