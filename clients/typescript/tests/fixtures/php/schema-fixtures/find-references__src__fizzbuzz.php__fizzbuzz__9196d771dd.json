      "source_code": "final class FizzBuzz {\n  public static function fizzbuzz(int $n): string {\n    if ($n % 15 === 0) return \"fizzbuzz\";\n    if ($n % 3 === 0) return \"fizz\";\n    if ($n % 5 === 0) return \"buzz\";\n    return strval($n);\n  }\n"
