      "source_code": "# frozen_string_literal: true\n\nmodule FizzBuzz\n  extend T::Sig\n\n  sig { params(n: Integer).returns(String) }\n  def self.value(n)\n    if (n % 15).zero?\n      \"FizzBuzz\"\n    elsif (n % 3).zero?\n      \"Fizz\"\n    elsif (n % 5).zero?\n      \"Buzz\"\n    else\n      n.to_s\n    end\n  end\n\n  sig { params(limit: Integer).returns(T::Array[String]) }\n  def self.series(limit)\n    (1..limit).map { |i| value(i) }\n  end\n"
    }
