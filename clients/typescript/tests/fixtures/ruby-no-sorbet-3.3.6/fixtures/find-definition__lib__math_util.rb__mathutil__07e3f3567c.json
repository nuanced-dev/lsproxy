      "source_code": "# frozen_string_literal: true\n\nmodule Utils\n  module MathUtil\n    extend T::Sig\n\n    sig { params(xs: T::Array[Integer]).returns(Integer) }\n    def self.sum(xs)\n      xs.reduce(0, :+)\n    end\n\n    sig { params(n: Integer).returns(Integer) }\n    def self.factorial(n)\n      raise ArgumentError, \"n must be >= 0\" if n.negative?\n      (1..n).reduce(1, :*)\n    end\n  end\n"
    }
