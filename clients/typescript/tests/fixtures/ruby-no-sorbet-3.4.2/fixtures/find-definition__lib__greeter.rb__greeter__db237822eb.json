      "source_code": "\nrequire_relative \"fizz_buzz\"\n\nclass Greeter\n  extend T::Sig\n\n  sig { params(name: String).void }\n  def initialize(name)\n    @name = name\n  end\n\n  sig { returns(String) }\n  def hello\n    series = FizzBuzz.series(5).join(\", \")\n    \"Hello, #{@name}! Here's some FizzBuzz: #{series}\"\n  end\n"
    }
